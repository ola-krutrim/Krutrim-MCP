# Krutrim MCP server 1.0.5 — API-key-only configuration.
# Create a key in Cloud Console > Administration > API keys > Create API Key;
# set it privately in the MCP server process environment. Never commit a real key.
# This file is a template; the server does not automatically load .env files.
KRUTRIM_API_KEY=

# Authentication requires KRUTRIM_API_KEY; no environment-cleanup wrapper is needed.
# The configured gateway must support API-key authentication. No token exchange
# or refresh occurs. Restart the MCP client after replacing or rotating the key.

# API base URL.
# KRUTRIM_BASE_URL=https://cloud.olakrutrim.com

# Optional display context; calls still require an explicit region.
# KRUTRIM_DEFAULT_REGION=In-Bangalore-1

# Optional hard lock. When unset or false, supported mutations are available but
# still require confirm=true after review.
# KRUTRIM_MCP_READ_ONLY=true

# Keep retries at 0 to prevent duplicate resources after create timeouts.
KRUTRIM_CLIENT_MAX_RETRIES=0

# SDK request timeout in seconds.
# KRUTRIM_CLIENT_TIMEOUT_SECONDS=30

# Timeout for create_instance in seconds (VM creation is slow; the default
# 600s prevents ambiguous client timeouts that hide a successful, billable
# create).
# KRUTRIM_CREATE_TIMEOUT_SECONDS=600

# Logging: DEBUG, INFO, WARNING, ERROR
# KRUTRIM_MCP_LOG_LEVEL=INFO
